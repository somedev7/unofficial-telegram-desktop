# Branding of the unofficial build (Telegram API ToS 2.3/2.4: the word
# "Telegram" only after "Unofficial", no official logo).
APP_NAME="Unofficial Telegram Desktop"   # AppName: tray tooltip, notifications, media controls
APP_SHORT_NAME="Unofficial Telegram"     # window title, .desktop Name
APP_ID="unofficial.telegram.desktop"     # .desktop / D-Bus / icon theme id, must differ from org.telegram.desktop
