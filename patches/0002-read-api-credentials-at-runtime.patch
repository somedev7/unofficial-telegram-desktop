diff --git a/Telegram/SourceFiles/settings.cpp b/Telegram/SourceFiles/settings.cpp
index 770e63b02..3b25905f9 100644
--- a/Telegram/SourceFiles/settings.cpp
+++ b/Telegram/SourceFiles/settings.cpp
@@ -63,3 +63,167 @@ int gOtherOnline = 0;
 int32 gAutoDownloadPhoto = 0; // all auto download
 int32 gAutoDownloadAudio = 0;
 int32 gAutoDownloadGif = 0;
+
+// Fork: runtime api_id / api_hash, see config.h.
+#include <QtCore/QJsonDocument>
+#include <QtCore/QJsonObject>
+#include <QtCore/QRegularExpression>
+#include <QtCore/QSaveFile>
+#include <QtWidgets/QInputDialog>
+#include <QtWidgets/QLineEdit>
+#include <QtWidgets/QMessageBox>
+
+#include <limits>
+#include <mutex>
+#include <optional>
+
+namespace ForkApi {
+namespace {
+
+constexpr auto kTestApiId = 17349;
+
+struct Credentials {
+	int id = 0;
+	QByteArray hash;
+};
+
+std::mutex CredentialsMutex;
+std::optional<Credentials> Cached;
+
+[[nodiscard]] QByteArray NormalizeHash(const QString &value) {
+	return value.trimmed().toLower().toLatin1();
+}
+
+[[nodiscard]] bool Valid(int id, const QByteArray &hash) {
+	static const auto kHashRegExp = QRegularExpression(u"^[0-9a-f]{32}$"_q);
+	return (id > 0)
+		&& kHashRegExp.match(QString::fromLatin1(hash)).hasMatch();
+}
+
+[[nodiscard]] Credentials Load() {
+	const auto envId = qEnvironmentVariableIntValue("TDESKTOP_API_ID");
+	const auto envHash = NormalizeHash(
+		qEnvironmentVariable("TDESKTOP_API_HASH"));
+	if (Valid(envId, envHash)) {
+		return { envId, envHash };
+	}
+	auto file = QFile(Path());
+	if (file.open(QIODevice::ReadOnly)) {
+		const auto object = QJsonDocument::fromJson(file.readAll()).object();
+		const auto id = object.value(u"api_id"_q).toInt();
+		const auto hash = NormalizeHash(
+			object.value(u"api_hash"_q).toString());
+		if (Valid(id, hash)) {
+			return { id, hash };
+		}
+		LOG(("Fork Error: bad api_id / api_hash in '%1'.").arg(Path()));
+	}
+	const auto compiledHash = QByteArray(kCompiledHash);
+	if (kCompiledId != kTestApiId && Valid(kCompiledId, compiledHash)) {
+		return { kCompiledId, compiledHash };
+	}
+	return {};
+}
+
+[[nodiscard]] const Credentials &Current() {
+	static const auto empty = Credentials();
+	const auto lock = std::lock_guard(CredentialsMutex);
+	if (!Cached) {
+		if (cWorkingDir().isEmpty()) {
+			return empty; // Too early to look for the file, don't cache.
+		}
+		Cached = Load();
+	}
+	return *Cached;
+}
+
+[[nodiscard]] bool Save(int id, const QByteArray &hash) {
+	auto object = QJsonObject();
+	object.insert(u"api_id"_q, id);
+	object.insert(u"api_hash"_q, QString::fromLatin1(hash));
+	auto file = QSaveFile(Path());
+	if (!file.open(QIODevice::WriteOnly)) {
+		return false;
+	}
+	file.write(QJsonDocument(object).toJson());
+	if (!file.commit()) {
+		return false;
+	}
+	QFile::setPermissions(
+		Path(),
+		QFileDevice::ReadOwner | QFileDevice::WriteOwner);
+	const auto lock = std::lock_guard(CredentialsMutex);
+	Cached = Credentials{ id, hash };
+	return true;
+}
+
+} // namespace
+
+QString Path() {
+	return cWorkingDir() + u"api_credentials.json"_q;
+}
+
+bool Ready() {
+	return Current().id > 0;
+}
+
+bool AskAndSave() {
+	const auto title = u"API credentials"_q;
+	QMessageBox::information(
+		nullptr,
+		title,
+		(u"This unofficial build has no api_id / api_hash built in.\n\n"
+			u"Get your own at https://my.telegram.org > "
+			u"API development tools and enter them on the next screens. "
+			u"They will be saved to:\n%1\n\n"
+			u"You can also set the TDESKTOP_API_ID and TDESKTOP_API_HASH "
+			u"environment variables instead."_q).arg(Path()));
+	while (true) {
+		auto ok = false;
+		const auto id = QInputDialog::getInt(
+			nullptr,
+			title,
+			u"api_id:"_q,
+			0,
+			0,
+			std::numeric_limits<int>::max(),
+			1,
+			&ok);
+		if (!ok) {
+			return false;
+		}
+		const auto hash = NormalizeHash(QInputDialog::getText(
+			nullptr,
+			title,
+			u"api_hash (32 hex characters):"_q,
+			QLineEdit::Normal,
+			QString(),
+			&ok));
+		if (!ok) {
+			return false;
+		} else if (!Valid(id, hash)) {
+			QMessageBox::warning(
+				nullptr,
+				title,
+				u"Wrong api_id or api_hash, try again."_q);
+			continue;
+		} else if (!Save(id, hash)) {
+			QMessageBox::critical(
+				nullptr,
+				title,
+				u"Could not write %1."_q.arg(Path()));
+			return false;
+		}
+		return true;
+	}
+}
+
+int Id() {
+	return Current().id;
+}
+
+const char *Hash() {
+	return Current().hash.constData();
+}
+
+} // namespace ForkApi
